# Copy to .env (never commit .env). Loaded by `npm run start:backend` via node --env-file.

# --- HTTP ---
PORT=3000
HOST=127.0.0.1
# Shared secret(s) the Chrome extension sends as "Authorization: Bearer <key>". 16+ chars. Comma-separate to rotate.
API_KEYS=replace-with-a-long-random-string

# --- Google Sheet (paste the browser URL, or set SHEET_ID + SHEET_GID/SHEET_TAB) ---
SHEET_URL=https://docs.google.com/spreadsheets/d/10sk2-aVC824trbNjPmfaARiTwSh18WGhqD5ryanEhbI/edit?gid=1793568655
HEADER_ROWS=1
COL_EMAILS=G
COL_SUBJECT=H
COL_BODY=I
COL_STATUS=J
# Optional free-text column for error notes / timestamps (leave empty to disable)
COL_NOTE=

# --- Google OAuth (run `npm run auth --workspace backend` once to obtain the refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Safety ---
# Reject claims closer together than this (seconds). The extension already waits 10-20 min.
MIN_CLAIM_INTERVAL_SEC=300
MAX_CC=20
