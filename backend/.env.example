# Copy to .env (never commit .env). Loaded by `npm run start:backend` via node --env-file.

# --- HTTP ---
PORT=3000
HOST=127.0.0.1
# Shared secret(s) the Chrome extension sends as "Authorization: Bearer <key>". 16+ chars. Comma-separate to rotate.
API_KEYS=replace-with-a-long-random-string

# --- Where the rows live: a local Excel file (default) or Google Sheets ---
DATA_SOURCE=xlsx
# Path to the .xlsx file (relative to where you start the backend, or absolute). Keep it OUT of git.
XLSX_PATH=./data/contact_out.xlsx
# Worksheet name; empty = first sheet
XLSX_SHEET=
HEADER_ROWS=1
COL_EMAILS=G
COL_SUBJECT=H
COL_BODY=I
COL_STATUS=J
# Optional free-text column for error notes / timestamps (leave empty to disable, e.g. K)
COL_NOTE=
# Which extension profile (Outlook account) claimed each row. Default L; empty disables it.
COL_SENDER=L

# --- Only for DATA_SOURCE=google ---
# The sheet (paste the browser URL; the gid=... part selects the tab):
# SHEET_URL=https://docs.google.com/spreadsheets/d/<id>/edit?gid=<gid>
# Recommended login: a service account key (JSON file from Google Cloud). Share the sheet with its email as Editor.
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# Alternative login as your own Google user (needs `npm run auth --workspace backend` once):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Safety ---
# Reject claims from the SAME extension profile closer together than this (seconds). The extension already waits 10-20 min.
MIN_CLAIM_INTERVAL_SEC=300
MAX_CC=20
